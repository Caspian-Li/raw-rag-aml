# Copy to .env; fill in real secrets locally. Never commit .env.
AML_MEMORY_KEY=
AML_AUTH_SCHEME=bearer

# Academic division requires this model. No fallback to another model.
AML_EMBEDDING_MODEL=text-embedding-v4
AML_EMBEDDING_API_KEY=
# Example China (Beijing) endpoint; use the endpoint matching your provider/key.
# Workspace-specific domains are also supported.
AML_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

AML_RERANK_API_KEY=
AML_RERANK_BASE_URL=https://api.cohere.com
AML_DATABASE=./data/memory.sqlite3
AML_ADD_CONCURRENCY=2
AML_SEARCH_CONCURRENCY=2
AML_MAX_BODY_BYTES=16777216
AML_OPERATION_TIMEOUT_SECONDS=1700
# Idle records expire before the competition's 30-day retention limit.
AML_RETENTION_DAYS=29
